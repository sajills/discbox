{
  "name": "discbox",
  "version": "1.0.0",
  "private": true,
  "description": "Discbox - a music player made of spinning CDs",
  "main": "electron/main.cjs",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.sajills.discbox.desktop",
    "productName": "Discbox",
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
